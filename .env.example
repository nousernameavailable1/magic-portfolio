# Copy this file to .env on the OCI VM. Do not commit the real .env file.
# Use long, unique values. For POSTGRES_PASSWORD and ADMIN_SESSION_SECRET,
# `openssl rand -hex 32` produces a Docker/URL-safe value.

# Password for the existing portfolio route protection.
PAGE_ACCESS_PASSWORD=replace-with-a-new-site-password

# PostgreSQL credentials. The database remains private to Docker.
POSTGRES_PASSWORD=replace-with-64-random-hex-characters

# Private /admin access and signed session cookies.
ADMIN_PASSWORD=replace-with-a-unique-admin-password
ADMIN_SESSION_SECRET=replace-with-64-random-hex-characters

# Personal @kadli.org mail stays on iCloud. Fakemail uses Cloudflare Email Routing
# on temp.kadli.org; see docs/fakemail.md for DNS setup and migration.
# Token: Zone / Email Routing Rules: Edit, scoped to kadli.org.
# Use the parent kadli.org zone ID and a verified destination inbox.
CLOUDFLARE_API_TOKEN=replace-with-a-cloudflare-api-token
CLOUDFLARE_ZONE_ID=replace-with-the-kadli-org-zone-id
FAKEMAIL_DOMAIN=temp.kadli.org
FAKEMAIL_FORWARD_TO=your-verified-address@icloud.com
FAKEMAIL_CLEANUP_SECRET=replace-with-64-random-hex-characters

# Optional value shown only in /admin/status. The deployed commit SHA is injected
# automatically by the Docker image build workflow.
GITHUB_REPOSITORY=nousernameavailable1/magic-portfolio

# Optional Docker host bridge; see deploy/host-agent/README.md.
# Generate HOST_AGENT_TOKEN with `openssl rand -hex 32`; keep it server-side.
# HOST_AGENT_TOKEN=
# HOST_COMPOSE_DIRECTORY=/opt/magic-portfolio
# HOST_COMPOSE_PROJECT_NAME=your-existing-site-project
